# Hostinger FTP — encontre em hPanel > Arquivos > Contas FTP
HOSTINGER_FTP_HOST=ftp.nerdcaseiro.com.br
HOSTINGER_FTP_USER=u123456789
HOSTINGER_FTP_PASS=
HOSTINGER_FTP_DIR=/public_html

# Mercado Livre — link de afiliado (perfil da conta: "Rede Caseira")
MERCADOLIVRE_AFFILIATE_LINK=

# Amazon Associados — sua tag de associado (ex.: nerdcaseiro-20)
AMAZON_AFFILIATE_TAG=nerdcaseiro-20

# Hotmart — link de afiliado dos cursos (Home Assistant, modelagem 3D, etc.)
HOTMART_AFFILIATE_LINK=
