---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const categoryLabels: Record<string, string> = {
    'automacao-residencial': 'Automação Residencial',
    'casa-inteligente': 'Casa Inteligente',
    'impressao-3d': 'Impressão 3D',
    'eletronica-maker': 'Eletrônica Maker',
    'ferramentas-maker': 'Ferramentas Maker',
    gadgets: 'Gadgets',
    'audio-video': 'Áudio & Vídeo',
    'redes-wifi': 'Redes & Wi-Fi',
    'energia-backup': 'Energia & Backup',
    'home-office': 'Home Office',
    guias: 'Guias de Compra',
  };


  // Título e meta descrição próprios por categoria: o padrão anterior
  // (`${label} — Reviews e Guias`) gerava títulos curtos demais para o Bing.
  const categorySeo: Record<string, { title: string; description: string }> = {
    'automacao-residencial': {
      title: 'Automação residencial com Home Assistant e ESP32',
      description: 'Tutoriais com código testado de Home Assistant, ESPHome e ESP32: automatize luz, portão, cortina e irrigação sem depender da nuvem de ninguém.',
    },
    'casa-inteligente': {
      title: 'Casa inteligente: lâmpadas, sensores, hubs e câmeras',
      description: 'Lâmpadas e tomadas inteligentes, sensores, fechaduras, hubs e câmeras comparados: o que funciona junto, o que trava e o que vale o investimento.',
    },
    'impressao-3d': {
      title: 'Impressão 3D: impressoras, filamentos e ajustes finos',
      description: 'Impressoras FDM e resina, filamentos PLA, PETG e ABS, secagem e solução de falhas de impressão: o guia de quem imprime de verdade em casa.',
    },
    'eletronica-maker': {
      title: 'Eletrônica maker: ESP32, Arduino e Raspberry Pi',
      description: 'Projetos e componentes de eletrônica maker com ESP32, Arduino e Raspberry Pi: sensores, kits iniciantes e montagens com código real e testado.',
    },
    'ferramentas-maker': {
      title: 'Ferramentas maker: solda, multímetro e bancada',
      description: 'Ferro e estação de solda, multímetro, fonte e organização de bancada: o que realmente falta na sua para os projetos pararem de travar no meio.',
    },
    gadgets: {
      title: 'Gadgets de tecnologia úteis para a casa e o dia a dia',
      description: 'Gadgets testados de verdade: smartwatch, leitor digital, rastreador, umidificador e acessórios que resolvem algo concreto na rotina da casa.',
    },
    'audio-video': {
      title: 'Áudio e vídeo: streaming, smart TV, fones e som',
      description: 'Fire TV, Chromecast, Roku, smart TVs, fones e caixas de som comparados: o que muda entre os sistemas e como montar o entretenimento da sala.',
    },
    'redes-wifi': {
      title: 'Redes e Wi-Fi: roteadores mesh, repetidores e cabo',
      description: 'Roteadores mesh, repetidores e cabeamento comparados: como resolver o Wi-Fi fraco no fundo da casa e quando o cabo entrega o que o sem fio não dá.',
    },
    'energia-backup': {
      title: 'Energia e backup: nobreak, DPS, pilhas e power bank',
      description: 'Nobreak, filtro de linha com DPS, estação portátil, pilhas e power bank: como manter internet, computador e aparelhos vivos na queda de energia.',
    },
    'home-office': {
      title: 'Home office: monitor, teclado, hub USB-C e impressora',
      description: 'Monitores, suportes, teclados, hubs USB-C, webcams e impressoras comparados: como montar uma mesa de trabalho que aguenta oito horas por dia.',
    },
    guias: {
      title: 'Guias de tecnologia caseira explicados sem enrolação',
      description: 'Guias completos de automação, casa inteligente, impressão 3D e home office: o conceito, a escolha certa e os erros que custam caro na prática.',
    },
  };

  const allPosts = await getCollection('posts', ({ data }) => !data.draft);

  return Object.keys(categoryLabels).map((slug) => ({
    params: { slug },
    props: {
      label: categoryLabels[slug],
      seo: categorySeo[slug],
      posts: allPosts
        .filter((p) => p.data.category === slug)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { slug } = Astro.params;
const { label, seo, posts } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  title={seo?.title ?? `${label} — Reviews e Guias`}
  description={seo?.description ?? `Tutoriais, reviews e guias de compra sobre ${label.toLowerCase()} para sua casa inteligente.`}
>
  <div class="container section">
    <nav class="cat-breadcrumb" aria-label="Navegação por categoria">
      <a href="/categorias/">← Todas as categorias</a>
    </nav>

    <h1 class="cat-title">{label}</h1>

    {posts.length === 0 ? (
      <div class="cat-empty">
        <div class="cat-empty__icon">⚙️</div>
        <h2>Em breve por aqui</h2>
        <p>Ainda não temos artigos de <strong>{label.toLowerCase()}</strong>, mas estamos preparando conteúdo de qualidade. Volte em breve!</p>
        <a href="/categorias/" class="btn-outline">Ver outras categorias</a>
      </div>
    ) : (
      <div class="post-grid">
        {posts.map((post) => {
          const thumb = post.data.products?.[0]?.image;
          return (
            <article class="post-card">
              <div class="post-card__thumb">
                {thumb
                  ? <img src={thumb} alt={post.data.title} loading="lazy" />
                  : <span>⚙️</span>
                }
              </div>
              <div class="post-card__body">
                <a href={`/posts/${post.slug}/`} class="post-card__link">
                  <h3>{post.data.title}</h3>
                </a>
                <p class="post-card__excerpt">{post.data.description}</p>
                <div class="post-card__footer">
                  <span class="post-card__date">{formatDate(post.data.pubDate)}</span>
                  <a href={`/posts/${post.slug}/`} class="post-card__read">Ler artigo →</a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
.cat-breadcrumb {
  margin-bottom: 1.25rem;
  font-size: 0.875rem;
}
.cat-breadcrumb a {
  color: var(--color-teal);
  text-decoration: none;
}
.cat-breadcrumb a:hover { text-decoration: underline; }

.cat-title {
  font-size: 2rem;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--color-border);
}

.cat-empty {
  text-align: center;
  padding: 4rem 1.5rem;
  max-width: 480px;
  margin: 0 auto;
}
.cat-empty__icon { font-size: 3.5rem; margin-bottom: 1rem; }
.cat-empty h2 { font-size: 1.5rem; margin-bottom: 0.75rem; }
.cat-empty p { color: var(--color-text-muted); margin-bottom: 1.5rem; line-height: 1.7; }
.btn-outline {
  display: inline-block;
  padding: 0.6rem 1.4rem;
  border: 2px solid var(--color-orange);
  color: var(--color-orange);
  border-radius: var(--radius-md);
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s;
}
.btn-outline:hover { background: var(--color-orange); color: #fff; }
</style>
